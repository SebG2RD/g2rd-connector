{
    "name": "g2rd/connector",
    "description": "Plugin WordPress qui connecte un site au tableau de bord G2RD WP Manager.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        { "name": "Sebastien Gerard", "email": "contact@g2rd.fr", "homepage": "https://g2rd.fr" }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "paragonie/sodium_compat": "1.24.0",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5.62",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "G2RD\\Connector\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "G2RD\\Connector\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=2G",
        "test": "phpunit",
        "ci": [ "@lint", "@analyse", "@test" ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "audit": {
            "ignore": {
                "PKSA-32g2-byr9-drtw": "Épinglage voulu, développement seulement (absent du ZIP) : sodium_compat 1.24.0 est la copie que WordPress 6.9 à 7.1.3 livre au parc ; les tests « compat » doivent voir son contrôle du sous-groupe inopérant (tests/Backup/Crypto/SodiumCompatCopieTest.php)."
            }
        },
        "sort-packages": true,
        "platform": {
            "php": "8.1.99"
        }
    }
}
