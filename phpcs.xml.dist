<?xml version="1.0"?>
<ruleset name="G2RD Connector">
    <description>WordPress Coding Standards for G2RD Connector plugin (PSR-4, PHP 8.1+).</description>

    <file>./g2rd-connector.php</file>
    <file>./includes</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>
    <arg name="basepath" value="."/>

    <rule ref="WordPress-Core">
        <!-- Le plugin charge ses classes en PSR-4 (composer.json + includes/autoload.php) :
             les fichiers sont nommés en PascalCase (Plugin.php), pas en class-*.php WordPress. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- Code PHP 8.1 moderne : on autorise la syntaxe courte des tableaux ([] plutôt que array()). -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <!-- WordPress-Docs (docblocks de classes/fonctions obligatoires) est désactivé
         pour l'instant : le code du scaffold n'est pas encore entièrement documenté.
         À réactiver une fois les docblocks ajoutés (cf. README, section Qualité). -->
    <!-- <rule ref="WordPress-Docs"/> -->

    <config name="testVersion" value="8.1-"/>
    <config name="minimum_supported_wp_version" value="6.4"/>
</ruleset>
