# Normalisation des fins de ligne — évite que les scripts shell committés en CRLF
# (Windows) cassent bash sur les runners Linux du CI.
* text=auto

*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.php   text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.neon  text eol=lf

*.ps1   text eol=crlf

# Fichiers binaires
*.png   binary
*.jpg   binary
*.zip   binary
*.mo    binary
