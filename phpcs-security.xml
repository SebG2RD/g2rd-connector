<?xml version="1.0"?>
<ruleset name="G2RD Connector Security">
    <description>SAST OWASP (phpcs-security-audit) pour le plugin G2RD Connector.</description>

    <file>./g2rd-connector.php</file>
    <file>./includes</file>
    <file>./uninstall.php</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <!-- Standard fourni par pheromone/phpcs-security-audit -->
    <rule ref="Security"/>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/admin/build/*</exclude-pattern>
</ruleset>
